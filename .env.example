# 复制为 .env 后按需修改；**不要**把 .env 提交到仓库
# 生成强随机密钥： openssl rand -base64 32

# —— 必填（docker compose 缺失变量时会直接报错）——
# JWT 签名密钥，至少 16 字符；生产环境必须显式设置，否则服务拒绝启动
JWT_SECRET=change-me-to-a-random-32-chars-string
# 管理员初始口令；修改后重启容器即生效
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# —— 可选 ——
# 对外端口
PORT=3000
# 订阅同步并发上限（1-20）
SYNC_CONCURRENCY=5
# 是否启用内置定时调度（含订阅同步、每日提醒扫描、每日数据库备份）
ENABLE_SCHEDULER=true
# 容器时区（影响 cron 执行时间）
TZ=Asia/Shanghai
# —— 系统备份（TASK-015，详见 docs/operations/backup-restore.md）——
# 每日备份 cron（5 段：分 时 日 月 周），默认每天 03:00
BACKUP_CRON=0 3 * * *
# 备份保留份数，超出删最旧；默认 7
BACKUP_KEEP=7
# 备份目录（绝对路径）；默认 <数据库所在目录>/backups
# docker 部署建议保持默认（卷内 ./data/backups，随卷持久化）；指向卷外路径前
# 确认该路径已另行持久化，否则删容器即丢备份
# BACKUP_DIR=/data/backups
