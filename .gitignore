# Logs（仅限根目录；勿用裸 `logs`，会误伤 src/features/logs/ 与 src/routes/_authenticated/logs/）
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
/coverage

# Vitest artifacts (browser screenshots/attachments)
**/__screenshots__/
.vitest-attachments/

# SQLite 数据文件（运行时产物，挂载卷持久化）
/data
*.db
*.db-shm
*.db-wal

# agent 临时文件 / PR 描述草稿（TASK-032 D2 主控位裁决纳入 ignore）
.workbuddy/

# TASK-040 temporary files
.task040-*
